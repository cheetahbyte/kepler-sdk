{
  "name": "@kepler-app/plugin-sdk",
  "version": "0.6.0",
  "description": "TypeScript SDK for building Kepler plugins.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kepler-plugin": "./dist/cli.js"
  },
  "files": [
    "dist",
    "runtime.d.ts"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm run build"
  },
  "keywords": [
    "kepler",
    "plugin",
    "sdk"
  ],
  "author": "Leonhard Breuer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cheetahbyte/kepler-sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsup": "^8.0.0",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
